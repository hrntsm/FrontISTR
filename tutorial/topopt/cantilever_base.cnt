!! Cantilever topology optimization - base control file
!! Material definitions (per-element E via SIMP) are prepended each iteration.
!! This file contains only: boundary conditions, output settings, solver settings.
!VERSION
 3
!SOLUTION, TYPE=STATIC
!WRITE,RESULT
!OUTPUT_RES
 ESTRESS, ON
 ESTRAIN, ON
!BOUNDARY
 FIX, 1, 3, 0.0
!CLOAD
 LOAD, 2, -0.500000
!SOLVER, METHOD=CG, PRECOND=1, ITERLOG=NO, TIMELOG=NO
 10000, 1
 1.0e-8, 1.0, 0.0
!END
